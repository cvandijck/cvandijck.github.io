npm run build
if ! git diff --quiet -- assets/styles/main.min.css; then
  echo "assets/styles/main.min.css is out of date. Run npm run build and git add assets/styles/main.min.css."
  exit 1
fi

npm run format
if ! git diff --quiet -- ':(glob)**/*.html'; then
  echo "Prettier reformatted one or more HTML files. Review the changes, git add them, and commit again."
  exit 1
fi

